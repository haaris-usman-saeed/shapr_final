          "scene": "t_panels",
          "variant": "files",
          "dur": 13.0,
          "music": "theme",
          "narration": [
            {
              "id": "T01c",
              "at": 0.8,
              "text": "Open a file while you work, and Shapr offers to add it."
            },
            {
              "id": "T01d",
              "at": 8.5,
              "text": "Capture the same thing twice, and it isn't saved twice."
            }
