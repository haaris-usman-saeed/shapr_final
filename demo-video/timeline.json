          "music": "theme",
          "statements": [],
          "narration": [
            {
              "id": "T05a",
              "at": 0.6,
              "text": "Shapr drafts from the pack, and only from the pack. Nothing is pasted until you press Insert."
            },
            {
              "id": "T05b",
              "at": 7.0,
              "text": "Forms are filled with values from your notes. You check each one. You press Submit."
            }
