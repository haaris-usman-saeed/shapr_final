          "music": "theme",
          "narration": [
            {
              "id": "T03a",
              "at": 1.0,
              "text": "Ask a question, and Shapr answers from your notes."
            },
            {
              "id": "T03b",
              "at": 9.0,
              "text": "Each point cites its source. Answers run on your Mac, or with Claude if you add your own key."
