          "scene": "s04_packs",
          "from": 0,
          "dur": 7.3,
          "music": "theme",
          "statements": [],
          "narration": [
            {
              "id": "T01b",
              "at": 0.5,
              "text": "Or highlight text and press Option C. Every capture keeps its source."
            }
          ]
        },
