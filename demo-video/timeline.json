          "scene": "t_panels",
          "variant": "style",
          "dur": 12.0,
          "music": "theme",
          "narration": [
            {
              "id": "T05c",
              "at": 0.8,
              "text": "It picks the right pack for who you're writing to, and it can borrow your voice from a style pack, without taking facts from it."
